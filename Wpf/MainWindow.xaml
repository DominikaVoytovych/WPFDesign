<Window x:Class="ModernApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent">

    <Window.Resources>
        
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="15,5,15,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#878799"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#12121A" CornerRadius="16" BorderBrush="#232333" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.4" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#171721" CornerRadius="16,0,0,16">
                <StackPanel Margin="0,30,0,0">
                    <!-- 2. ВИДАЛЕНО ВЛАСТИВІСТЬ LETTERSPACING -->
                    <TextBlock Text="N E X U S" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,50" />

                    <Button Content="Dashboard" Style="{StaticResource MenuButton}" Foreground="#8A64FF" Background="#232333" FontWeight="SemiBold"/>
                    <Button Content="Analytics" Style="{StaticResource MenuButton}" />
                    <Button Content="Projects" Style="{StaticResource MenuButton}" />
                    <Button Content="Messages" Style="{StaticResource MenuButton}" />
                    <Button Content="Settings" Style="{StaticResource MenuButton}" Margin="0,200,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Welcome back," Foreground="#878799" FontSize="14"/>
                        <TextBlock Text="Overview Dashboard" Foreground="#FFFFFF" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#1C1C28" CornerRadius="8" Width="250" Height="40" Padding="15,0" BorderBrush="#2A2A3D" BorderThickness="1">
                        <TextBlock Text="Search..." Foreground="#5C5C70" VerticalAlignment="Center" FontSize="13"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="#1C1C28" CornerRadius="12" Margin="0,0,15,15" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Total Revenue" Foreground="#878799" FontSize="14"/>
                            <TextBlock Text="$128,430" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBlock Text="+14.5% this month" Foreground="#00E676" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="#1C1C28" CornerRadius="12" Margin="7.5,0,7.5,15" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Active Users" Foreground="#878799" FontSize="14"/>
                            <TextBlock Text="24,912" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBlock Text="-2.4% this month" Foreground="#FF5252" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Background="#8A64FF" CornerRadius="12" Margin="15,0,0,15" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Pro Plan" Foreground="#E2D4FF" FontSize="14"/>
                            <TextBlock Text="Active" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBlock Text="Renews in 12 days" Foreground="#E2D4FF" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#1C1C28" CornerRadius="12" Margin="0,10,0,0" Padding="20">
                        <Grid>
                            <TextBlock Text="Performance Metrics" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Top"/>
                            <Path Stroke="#8A64FF" StrokeThickness="3" Stretch="Fill" Margin="0,40,0,0" Data="M 0,100 C 50,50 100,120 150,40 C 200,-20 250,80 300,20 C 350,-10 400,50 450,10"/>
                            <Path Stroke="#00E676" StrokeThickness="2" Stretch="Fill" Opacity="0.5" Margin="0,40,0,0" Data="M 0,80 C 60,90 120,40 180,60 C 240,80 300,20 360,50 C 420,80 450,30 450,30"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>